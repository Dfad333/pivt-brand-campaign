# Source photographs from Higgsfield (~1.3 GB) and motion renders (~4.4 GB).
# Deliberately not tracked — they would make the repo far too heavy to clone
# comfortably, and neither is needed to CREATE new content. See SETUP-LAPTOP.md
# for how to carry them across if you want to re-cut an existing poster's type.
raw/
motion/

__pycache__/
*.pyc

.DS_Store
Thumbs.db

# New content stays on the device that made it. This repo is the SETUP repo —
# code, docs, logos, the /pivtcontent command — not a content archive.
# The posters that were already tracked before this rule stay tracked as the
# reference set; anything new in final/ is ignored and saved locally only.
final/
